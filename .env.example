# Required: create an API key in Google AI Studio.
GEMINI_API_KEY=your_api_key_here

# Current Gemini model used by the app. Change if your account/project exposes another model.
GEMINI_MODEL=gemini-3.8-flash

# Optional local explanation model. Keep false for the simplest setup.
USE_LOCAL_EXPLANATION=false
LOCAL_EXPLANATION_MODEL=MBZUAI/LaMini-Flan-T5-783M
